{
  "name": "dipin-uptime",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:hub": "pnpm --filter hub dev",
    "dev:validator": "pnpm --filter validator dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:validate": "pnpm --filter @repo/db prisma validate",
    "start:web": "pnpm --filter web start"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "prisma": "^6.19.2",
    "react-resizable-panels": "^1.0.10"
  }
}
